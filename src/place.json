  "reviews": [
    {
      "author": "Ekaterina Dushko",
      "avatar": "https://lh3.googleusercontent.com/a-/ALV-UjXIGo6UN05FT6J5Qw9cKRCToE-skM4EIBMZP0FYzMnKMgACXDaB=s128-c0x00000000-cc-rp-mo-ba3",
      "rating": 5,
      "lang": "en",
      "date": "2025-06-12",
      "text": "A new and pretty good coffee shop. The girl who works here is very friendly and you can tell she cares about the place's appearance. They always ask me if I want my coffee lukewarm or really hot — in other places “hot” means almost cold, but here it really does burn your tongue… and I love it. The prices are very good compared to other coffee shops, and the coffee tastes excellent. The air conditioning is a lifesaver in the summer here too."
    },
    {
      "author": "matias emmanuel kuster",
      "avatar": "https://lh3.googleusercontent.com/a/ACg8ocKuXvPurfQM8psK6gtdzcBAaMYo27EzDgsg7vOaFLICn7niVA=s128-c0x00000000-cc-rp-mo",
      "rating": 5,
      "lang": "en",
      "date": "2025-08-17",
      "text": "Pleasant atmosphere. The coffee is quite good compared to other bars. The place is very comfortable, well-lit, air-conditioned, and has music (not too loud). The staff is excellent, always very helpful."
    },
    {
      "author": "Kanijo Kanoso VLife",
      "avatar": "https://lh3.googleusercontent.com/a-/ALV-UjUZx1Vb4QtVww6nrRmh8UdxF9tFNRJjpSA3xqUAuFZ8nSHgMMc=s128-c0x00000000-cc-rp-mo-ba3",
      "rating": 5,
      "lang": "en",
      "date": "2025-11-04",
      "text": "Excellent cafe. Very good seeded bread, some of the best coffee in the area, pleasant atmosphere."
    },
    {
